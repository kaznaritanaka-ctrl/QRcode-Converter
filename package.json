{
  "name": "qrcode-converter",
  "version": "0.1.0",
  "private": true,
  "description": "図案化したQRコード（碁石・通常ほか）を名刺として入稿用PDFに書き出すWebアプリ",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  }
}
